APP_NAME=Chat2Anything Migration API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8100

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chat2anything

JWT_SECRET=change_me_to_a_random_long_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=7200

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456
BOOTSTRAP_ADMIN_DEPARTMENT=platform

STORAGE_DIR=./storage/uploads
CONTEXT_WINDOW_DEFAULT=5
RAG_TOP_K=5

AUDIT_RETENTION_DAYS=180

